rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 每位學員（匿名登入）只能寫自己那一筆；登入者都能讀，供簡報統計。
    match /classes/{classId}/responses/{uid} {
      allow read: if request.auth != null;

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && classId.size() <= 40
        && request.resource.data.keys().hasOnly(['nick', 'team', 'ind', 'grp', 'updatedAt'])
        && (!('nick' in request.resource.data) || (request.resource.data.nick is string && request.resource.data.nick.size() <= 20))
        && (!('team' in request.resource.data) || (request.resource.data.team is string && request.resource.data.team.size() <= 20))
        && (!('ind'  in request.resource.data) || (request.resource.data.ind  is list   && request.resource.data.ind.size()  <= 14))
        && (!('grp'  in request.resource.data) || (request.resource.data.grp  is list   && request.resource.data.grp.size()  <= 14))
        && request.resource.data.updatedAt == request.time;

      allow delete: if false;
    }

    // 其他路徑一律拒絕
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
